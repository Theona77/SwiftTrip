class ScanFlowLauncher {
  <<ObservableObject>>
  +showScanFlow: Bool
  +show(source: Source)
  +launch(inputs: List~ScanInput~)
  +loadAndLaunch(items) async
  +handleFileImport(Result)
}

class ScanFlowCoordinator {
  <<View>>
  +source: Source
  +tripID: UUID?
